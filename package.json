{
  "name": "dsh-billremind",
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "description": "信用卡账单日、还款日与年费日的到期提醒面板",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "store.js",
    "dates.js",
    "service.js",
    "tools.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
